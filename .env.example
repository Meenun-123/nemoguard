# ==========================================
# Nebius x NVIDIA Global AI Hackathon Environment
# ==========================================

# Nebius Token Factory Configuration
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Model Selection (Qualifying open-source models)
# Primary: nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
# Alternative: nvidia/nemotron-4-340b-instruct
NVIDIA_MODEL_ID=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Execution Mode: "mock" (for offline/CPU testing without credentials) or "remote" (Nebius Token Factory)
AI_EXECUTION_MODE=mock

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Agent Guardrails & Limits
MAX_AGENT_ITERATIONS=6
TOOL_EXECUTION_TIMEOUT_SECONDS=30
ALLOW_DESTRUCTIVE_ACTIONS=false
